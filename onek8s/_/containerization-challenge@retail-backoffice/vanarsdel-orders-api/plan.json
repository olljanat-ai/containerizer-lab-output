{
  "component": "VanArsdel.Orders.Api",
  "kind": "dotnet",
  "role": "web",
  "project": "src/VanArsdel.Orders.Api/VanArsdel.Orders.Api.csproj",
  "tfm": "net6.0",
  "multi_target": false,
  "strategy": "rollforward",
  "base": "chiseled",
  "add_packages": [],
  "env": {
    "ASPNETCORE_HTTP_PORTS": "8080",
    "Serilog__WriteTo__0__Name": "Console",
    "DOTNET_ENVIRONMENT": "Production",
    "ASPNETCORE_ENVIRONMENT": "Production",
    "ASPNETCORE_URLS": "http://+:8080"
  },
  "add_writable": [
    "/tmp",
    "/home/app/.aspnet/DataProtection-Keys"
  ],
  "publish_args": [],
  "remove_files": [
    "global.json"
  ],
  "single_replica": false,
  "uid": 1654,
  "port": 8080,
  "health": null,
  "entry": "VanArsdel.Orders.Api.dll",
  "spa_root": null,
  "args": [],
  "applied": [
    "plan-global-json",
    "plan-dataprotection-keys",
    "plan-rid-portable-netstandard1"
  ],
  "reasons": [
    {
      "rule": "config-serilog-console",
      "why": "Serilog file sinks are switched to the console with an environment variable, so the cluster collects the logs from stdout.",
      "refs": [
        "https://github.com/serilog/serilog-sinks-console",
        "https://learn.microsoft.com/en-us/aspnet/core/fundamentals/configuration/"
      ]
    },
    {
      "rule": "own-runtime",
      "why": "Targets net6.0, which is out of support: it runs on its own .NET 6.0 runtime image (no longer patched), as built and tested, not rolled forward onto a newer runtime."
    },
    {
      "rule": "plan-global-json",
      "why": "global.json pins an SDK version that the build image may not have; it is removed in the build stage only (never in the repository) so the image's SDK builds the project.",
      "refs": [
        "https://learn.microsoft.com/en-us/dotnet/core/tools/global-json"
      ]
    },
    {
      "rule": "plan-dataprotection-keys",
      "why": "ASP.NET Core Data Protection keeps its key ring under the user's home folder. The generated manifests mount one key there, read-only, from a Secret that External Secrets Operator generates once in the cluster, so every replica and restart shares it (PersistKeysTo* in code takes over when present).",
      "refs": [
        "https://learn.microsoft.com/en-us/aspnet/core/security/data-protection/configuration/overview"
      ]
    },
    {
      "rule": "plan-rid-portable-netstandard1",
      "why": "A dependency built for netstandard1.x pins System.* 4.0.x packages (SSH.NET 2016.x directly; Microsoft.Azure.Amqp 2.5.6 through System.Net.WebSockets.Client 4.0.2, pulled in by Azure.Messaging.ServiceBus 7.5.0 and MassTransit.Azure.ServiceBus.Core 7.3). Restoring for the linux-x64 runtime identifier adds runtime.unix.* packages that need 4.3.0, which NuGet reports as a package downgrade (NU1605, an error in SDK builds). A portable publish (no -r) restores the same graph as the Windows build and runs on the Linux runtime image. Upgrading the package (SSH.NET 2020.0.0+, a current Azure.Messaging.ServiceBus) removes the conflict.",
      "refs": [
        "https://learn.microsoft.com/en-us/nuget/reference/errors-and-warnings/nu1605",
        "https://learn.microsoft.com/en-us/dotnet/core/rid-catalog",
        "https://www.nuget.org/packages/SSH.NET/2016.1.0",
        "https://www.nuget.org/packages/Microsoft.Azure.Amqp/2.5.6"
      ]
    }
  ],
  "runtime_line": "6.0",
  "rid": "portable",
