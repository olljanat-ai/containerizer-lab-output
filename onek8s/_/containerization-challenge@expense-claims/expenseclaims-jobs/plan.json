{
  "component": "ExpenseClaims.Jobs",
  "kind": "dotnet",
  "role": "web",
  "project": "src/ExpenseClaims.Jobs/ExpenseClaims.Jobs.csproj",
  "tfm": "net10.0",
  "multi_target": false,
  "strategy": "rollforward",
  "base": "chiseled",
  "add_packages": [],
  "env": {
    "ASPNETCORE_HTTP_PORTS": "8080",
    "Serilog__WriteTo__0__Name": "Console",
    "Bank__OutboundFolder": "/data/interfaces/bank/outbound",
    "CardImport__InboundFolder": "/data/interfaces/cards/inbound",
    "HrImport__InboundFolder": "/data/interfaces/hr/inbound",
    "DOTNET_ENVIRONMENT": "Production",
    "ASPNETCORE_ENVIRONMENT": "Production"
  },
  "add_writable": [
    "/tmp",
    "/data/interfaces/bank/outbound",
    "/data/interfaces/cards/inbound",
    "/data/interfaces/hr/inbound",
    "/home/app/.aspnet/DataProtection-Keys",
    "logs"
  ],
  "publish_args": [],
  "remove_files": [
    "global.json"
  ],
  "single_replica": false,
  "uid": 1654,
  "port": 8080,
  "health": "/health",
  "entry": "ExpenseClaims.Jobs.dll",
  "spa_root": null,
  "args": [],
  "applied": [
    "plan-global-json",
    "plan-dataprotection-keys",
    "plan-file-logs"
  ],
  "reasons": [
    {
      "rule": "config-serilog-console",
      "why": "Serilog file sinks are switched to the console with an environment variable, so the cluster collects the logs from stdout.",
      "refs": [
        "https://github.com/serilog/serilog-sinks-console",
        "https://learn.microsoft.com/en-us/aspnet/core/fundamentals/configuration/"
      ]
    },
    {
      "rule": "config-windows-paths",
      "why": "Windows paths in configuration (drive letters, UNC shares) are overridden with environment variables to folders under /data, which the manifests mount as volumes; the application code is not changed.",
      "refs": [
        "https://learn.microsoft.com/en-us/aspnet/core/fundamentals/configuration/"
      ]
    },
    {
      "rule": "plan-global-json",
      "why": "global.json pins an SDK version that the build image may not have; it is removed in the build stage only (never in the repository) so the image's SDK builds the project.",
      "refs": [
        "https://learn.microsoft.com/en-us/dotnet/core/tools/global-json"
      ]
    },
    {
      "rule": "plan-dataprotection-keys",
      "why": "ASP.NET Core Data Protection keeps its key ring under the user's home folder. The generated manifests mount one key there, read-only, from a Secret that External Secrets Operator generates once in the cluster, so every replica and restart shares it (PersistKeysTo* in code takes over when present).",
      "refs": [
        "https://learn.microsoft.com/en-us/aspnet/core/security/data-protection/configuration/overview"
      ]
    },
    {
      "rule": "plan-file-logs",
      "why": "The app logs to files under its own folder; the folder is made writable so start-up does not fail on the read-only root file system (console logging is preferred).",
      "refs": [
        "https://learn.microsoft.com/en-us/dotnet/core/extensions/logging/providers"
      ]
    }
  ],
  "egress": [
    {
      "id": "sql-server",
      "ports": [
        {
          "port": 1433,
          "protocol": "TCP"
        }
      ]
    },
    {
      "id": "smtp",
      "ports": [
        {
          "port": 25,
          "protocol": "TCP"
        },
        {
          "port": 465,
          "protocol": "TCP"
        },
        {
          "port": 587,
          "protocol": "TCP"
        }
      ]
    },
    {
      "id": "http-apis",
