        {
          "port": 443,
          "protocol": "TCP"
        },
        {
          "port": 80,
          "protocol": "TCP"
        }
      ]
    },
    {
      "id": "configured-ports",
      "ports": [
        {
          "port": 7048,
          "protocol": "TCP"
        },
        {
          "port": 8080,
          "protocol": "TCP"
        }
      ]
    }
  ],
  "hardening_exceptions": []
}