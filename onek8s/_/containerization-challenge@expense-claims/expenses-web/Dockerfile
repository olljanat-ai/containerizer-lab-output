# syntax=docker/dockerfile:1.7
# Generated by containerizer for expenses-web (single-page app, npm)
#
# Why this differs from a default build:
# - plan-global-json: global.json pins an SDK version that the build image may not have; it is
#   removed in the build stage only (never in the repository) so the image's SDK builds the project.
#   see https://learn.microsoft.com/en-us/dotnet/core/tools/global-json
FROM node:24-bookworm-slim AS build
WORKDIR /src
COPY src/expenses-web/ .
RUN find . -name 'global.json' -not -path '*/node_modules/*' -delete
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 CI=true
# optional build secret 'ca': CA bundle for TLS-inspecting corporate proxies
RUN --mount=type=cache,target=/root/.npm --mount=type=cache,target=/root/.local/share/pnpm/store --mount=type=secret,id=ca,required=false \
    if [ -f /run/secrets/ca ]; then export SSL_CERT_FILE=/run/secrets/ca NODE_EXTRA_CA_CERTS=/run/secrets/ca npm_config_cafile=/run/secrets/ca; fi; \
    npm ci --no-audit --no-fund
RUN --mount=type=secret,id=ca,required=false if [ -f /run/secrets/ca ]; then export SSL_CERT_FILE=/run/secrets/ca NODE_EXTRA_CA_CERTS=/run/secrets/ca npm_config_cafile=/run/secrets/ca; fi; \
    export NODE_ENV=production; \
    npm run build
RUN for d in 'dist/expenses-web/browser' 'dist/expenses-web' './dist' './build' './out'; do if [ -f "$d/index.html" ]; then cp -r "$d" /site; break; fi; done; [ -d /site ] || { echo "containerizer: no built index.html found" >&2; exit 1; }

FROM nginxinc/nginx-unprivileged:1.30.6-alpine AS final
# nginx-unprivileged runs as uid 101 and listens on 8080
COPY --from=build /site /usr/share/nginx/html
RUN printf 'server {\n listen 8080;\n root /usr/share/nginx/html;\n location / { try_files $uri $uri/ /index.html; }\n location = /healthz { return 200 "ok"; }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 8080
