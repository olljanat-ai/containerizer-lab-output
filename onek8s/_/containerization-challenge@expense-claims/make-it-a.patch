diff --git a/scenarios/expense-claims/src/ExpenseClaims.Jobs/Bank/BankGatewayClient.cs b/scenarios/expense-claims/src/ExpenseClaims.Jobs/Bank/BankGatewayClient.cs
index 5e700ca..e339469 100644
--- a/scenarios/expense-claims/src/ExpenseClaims.Jobs/Bank/BankGatewayClient.cs
+++ b/scenarios/expense-claims/src/ExpenseClaims.Jobs/Bank/BankGatewayClient.cs
@@ -49,6 +49,27 @@ public sealed class BankGatewayClient
     /// <summary>Loads the client certificate from the local machine certificate store.</summary>
     public static X509Certificate2 LoadClientCertificate(string thumbprint)
     {
+#if NET6_0_OR_GREATER
+        if (OperatingSystem.IsWindows())
+        {
+            using var store = new X509Store(StoreName.My, StoreLocation.LocalMachine);
+            store.Open(OpenFlags.ReadOnly | OpenFlags.OpenExistingOnly);
+            var found = store.Certificates.Find(X509FindType.FindByThumbprint, thumbprint.Replace(" ", ""), validOnly: false);
+            if (found.Count == 0)
+                throw new InvalidOperationException($"Bank client certificate {thumbprint} was not found in LocalMachine\\My.");
+            var certificate = found[0];
+            if (!certificate.HasPrivateKey)
+                throw new InvalidOperationException($"Bank client certificate {thumbprint} has no private key, or the application pool account cannot read it.");
+            return certificate;
+        }
+        else
+        {
+            // On Linux, load certificate from file path provided via configuration
+            var certPath = Environment.GetEnvironmentVariable("BANK_CLIENT_CERT_PATH") ?? throw new InvalidOperationException("BANK_CLIENT_CERT_PATH environment variable not set.");
+            var keyPath = Environment.GetEnvironmentVariable("BANK_CLIENT_KEY_PATH") ?? throw new InvalidOperationException("BANK_CLIENT_KEY_PATH environment variable not set.");
+            return X509Certificate2.CreateFromPemFile(certPath, keyPath);
+        }
+#else
         using var store = new X509Store(StoreName.My, StoreLocation.LocalMachine);
         store.Open(OpenFlags.ReadOnly | OpenFlags.OpenExistingOnly);
         var found = store.Certificates.Find(X509FindType.FindByThumbprint, thumbprint.Replace(" ", ""), validOnly: false);
@@ -58,5 +79,6 @@ public sealed class BankGatewayClient
         if (!certificate.HasPrivateKey)
             throw new InvalidOperationException($"Bank client certificate {thumbprint} has no private key, or the application pool account cannot read it.");
         return certificate;
+#endif
     }
 }
