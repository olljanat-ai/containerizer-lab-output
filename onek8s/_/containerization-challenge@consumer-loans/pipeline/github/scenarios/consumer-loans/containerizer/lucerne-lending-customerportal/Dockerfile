# syntax=docker/dockerfile:1.7
# Generated by containerizer for Lucerne.Lending.CustomerPortal (web, net6.0)
#
# Why this differs from a default build:
# - config-windows-paths: Windows paths in configuration (drive letters, UNC shares) are overridden
#   with environment variables to folders under /data, which the manifests mount as volumes; the
#   application code is not changed.
#   see https://learn.microsoft.com/en-us/aspnet/core/fundamentals/configuration/
# - own-runtime: Targets net6.0, which is out of support: it runs on its own .NET 6.0 runtime image
#   (no longer patched), as built and tested, not rolled forward onto a newer runtime.
# - plan-global-json: global.json pins an SDK version that the build image may not have; it is
#   removed in the build stage only (never in the repository) so the image's SDK builds the project.
#   see https://learn.microsoft.com/en-us/dotnet/core/tools/global-json
# - plan-sqlite-data: SQLite keeps data in a local file that only one process can safely write; the
#   component runs as a single replica with the file on a volume.
#   see https://learn.microsoft.com/en-us/dotnet/standard/data/sqlite/connection-strings
#   see https://kubernetes.io/docs/concepts/storage/persistent-volumes/
# - plan-file-logs: The app logs to files under its own folder; the folder is made writable so
#   start-up does not fail on the read-only root file system (console logging is preferred).
#   see https://learn.microsoft.com/en-us/dotnet/core/extensions/logging/providers
FROM mcr.microsoft.com/dotnet/sdk:10.0.403-noble AS build
COPY --from=node:22.23.4-bookworm-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22.23.4-bookworm-slim /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
WORKDIR /src
COPY . .
RUN find . -name 'global.json' -not -path '*/node_modules/*' -delete
RUN --mount=type=secret,id=ca,required=false \
    if [ -f /run/secrets/ca ]; then export SSL_CERT_FILE=/run/secrets/ca NODE_EXTRA_CA_CERTS=/run/secrets/ca; fi; \
    if grep -qs '"build"' "src/Lucerne.Lending.CustomerPortal/ClientApp/package.json"; then cd "src/Lucerne.Lending.CustomerPortal/ClientApp" && \
      if [ -f package-lock.json ]; then npm ci; else npm install; fi && npm run build && \
      mkdir -p /opt/npm-prebuilt && printf '#!/bin/sh\necho "npm $*: skipped, the front end was built before dotnet publish" >&2\n' \
        > /opt/npm-prebuilt/npm && chmod +x /opt/npm-prebuilt/npm; fi
# optional build secret 'ca': CA bundle for TLS-inspecting corporate proxies
RUN --mount=type=cache,target=/root/.nuget/packages --mount=type=secret,id=ca,required=false \
    if [ -f /run/secrets/ca ]; then export SSL_CERT_FILE=/run/secrets/ca NODE_EXTRA_CA_CERTS=/run/secrets/ca; fi; \
    export PATH=/opt/npm-prebuilt:$PATH; \
    dotnet restore "src/Lucerne.Lending.CustomerPortal/Lucerne.Lending.CustomerPortal.csproj" -p:RuntimeIdentifier=linux-x64 \
 && dotnet publish "src/Lucerne.Lending.CustomerPortal/Lucerne.Lending.CustomerPortal.csproj" --no-restore -c Release -o /out -p:UseAppHost=false -p:RuntimeIdentifier=linux-x64 --self-contained false
RUN mkdir -p /writable/app/logs /writable/data/consumerloans/portal/keys /writable/data/logs/consumerloans/portal /writable/tmp

FROM mcr.microsoft.com/dotnet/aspnet:6.0 AS final
WORKDIR /app
# application files stay owned by root: read-only for the app user
COPY --from=build /out .
COPY --from=build --chown=1654:1654 /writable/app/logs /app/logs
COPY --from=build --chown=1654:1654 /writable/data/consumerloans/portal/keys /data/consumerloans/portal/keys
COPY --from=build --chown=1654:1654 /writable/data/logs/consumerloans/portal /data/logs/consumerloans/portal
COPY --from=build --chown=1654:1654 /writable/tmp /tmp
ENV ASPNETCORE_ENVIRONMENT="Production" \
    ASPNETCORE_HTTP_PORTS="8080" \
    ASPNETCORE_URLS="http://+:8080" \
    DOTNET_ENVIRONMENT="Production" \
    DataProtection__KeysFolder="/data/consumerloans/portal/keys" \
    HOME="/home/app" \
    NLog__variables__logDir="/data/logs/consumerloans/portal"
USER 1654
EXPOSE 8080
ENTRYPOINT ["dotnet", "Lucerne.Lending.CustomerPortal.dll"]
