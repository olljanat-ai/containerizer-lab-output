# syntax=docker/dockerfile:1.7
# Generated by containerizer for CityPermits.Inspections (web, net6.0)
#
# Why this differs from a default build:
# - config-serilog-console: Serilog file sinks are switched to the console with an environment
#   variable, so the cluster collects the logs from stdout.
#   see https://github.com/serilog/serilog-sinks-console
#   see https://learn.microsoft.com/en-us/aspnet/core/fundamentals/configuration/
# - plan-global-json: global.json pins an SDK version that the build image may not have; it is
#   removed in the build stage only (never in the repository) so the image's SDK builds the project.
#   see https://learn.microsoft.com/en-us/dotnet/core/tools/global-json
# - plan-sqlite-data: SQLite keeps data in a local file that only one process can safely write; the
#   component runs as a single replica with the file on a volume.
#   see https://learn.microsoft.com/en-us/dotnet/standard/data/sqlite/connection-strings
#   see https://kubernetes.io/docs/concepts/storage/persistent-volumes/
# - plan-dataprotection-keys: ASP.NET Core Data Protection keeps its key ring under the user's home
#   folder. The generated manifests mount one key there, read-only, from a Secret that External
#   Secrets Operator generates once in the cluster, so every replica and restart shares it
#   (PersistKeysTo* in code takes over when present).
#   see https://learn.microsoft.com/en-us/aspnet/core/security/data-protection/configuration/overview
FROM mcr.microsoft.com/dotnet/sdk:10.0.403-noble AS build
COPY --from=node:22.23.4-bookworm-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22.23.4-bookworm-slim /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
WORKDIR /src
COPY . .
RUN find . -name 'global.json' -not -path '*/node_modules/*' -delete
RUN --mount=type=secret,id=ca,required=false \
    if [ -f /run/secrets/ca ]; then export SSL_CERT_FILE=/run/secrets/ca NODE_EXTRA_CA_CERTS=/run/secrets/ca; fi; \
    if grep -qs '"build"' "src/CityPermits.Inspections/ClientApp/package.json"; then cd "src/CityPermits.Inspections/ClientApp" && \
      if [ -f package-lock.json ]; then npm ci; else npm install; fi && npm run build && \
      mkdir -p /opt/npm-prebuilt && printf '#!/bin/sh\necho "npm $*: skipped, the front end was built before dotnet publish" >&2\n' \
        > /opt/npm-prebuilt/npm && chmod +x /opt/npm-prebuilt/npm; fi
# optional build secret 'ca': CA bundle for TLS-inspecting corporate proxies
RUN --mount=type=cache,target=/root/.nuget/packages --mount=type=secret,id=ca,required=false \
    if [ -f /run/secrets/ca ]; then export SSL_CERT_FILE=/run/secrets/ca NODE_EXTRA_CA_CERTS=/run/secrets/ca; fi; \
    export PATH=/opt/npm-prebuilt:$PATH; \
    dotnet restore "src/CityPermits.Inspections/CityPermits.Inspections.csproj" -p:RuntimeIdentifier=linux-x64 \
 && dotnet publish "src/CityPermits.Inspections/CityPermits.Inspections.csproj" --no-restore -c Release -o /out -p:UseAppHost=false -p:RuntimeIdentifier=linux-x64 --self-contained false
RUN mkdir -p /writable/home/app/.aspnet/DataProtection-Keys /writable/tmp

FROM mcr.microsoft.com/dotnet/aspnet:10.0.14-noble-chiseled-extra AS final
WORKDIR /app
# application files stay owned by root: read-only for the app user
COPY --from=build /out .
COPY --from=build --chown=1654:1654 /writable/home/app/.aspnet/DataProtection-Keys /home/app/.aspnet/DataProtection-Keys
COPY --from=build --chown=1654:1654 /writable/tmp /tmp
ENV ASPNETCORE_ENVIRONMENT="Production" \
    ASPNETCORE_HTTP_PORTS="8080" \
    DOTNET_ENVIRONMENT="Production" \
    DOTNET_ROLL_FORWARD="Major" \
    Kestrel__Endpoints__Http__Url="http://+:8080" \
    Serilog__WriteTo__0__Name="Console"
USER 1654
EXPOSE 8080
ENTRYPOINT ["dotnet", "CityPermits.Inspections.dll"]
