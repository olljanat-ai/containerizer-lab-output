# syntax=docker/dockerfile:1.7
# Generated by containerizer for ControlTower.Tower.Api (web, net6.0)
#
# Why this differs from a default build:
# - config-windows-paths: Windows paths in configuration (drive letters, UNC shares) are overridden
#   with environment variables to folders under /data, which the manifests mount as volumes; the
#   application code is not changed.
#   see https://learn.microsoft.com/en-us/aspnet/core/fundamentals/configuration/
# - plan-file-logs: The app logs to files under its own folder; the folder is made writable so
#   start-up does not fail on the read-only root file system (console logging is preferred).
#   see https://learn.microsoft.com/en-us/dotnet/core/extensions/logging/providers
# - plan-rid-portable-netstandard1: A dependency built for netstandard1.x pins System.* 4.0.x
#   packages (SSH.NET 2016.x directly; Microsoft.Azure.Amqp 2.5.6 through
#   System.Net.WebSockets.Client 4.0.2, pulled in by Azure.Messaging.ServiceBus 7.5.0 and
#   MassTransit.Azure.ServiceBus.Core 7.3). Restoring for the linux-x64 runtime identifier adds
#   runtime.unix.* packages that need 4.3.0, which NuGet reports as a package downgrade (NU1605, an
#   error in SDK builds). A portable publish (no -r) restores the same graph as the Windows build
#   and runs on the Linux runtime image. Upgrading the package (SSH.NET 2020.0.0+, a current
#   Azure.Messaging.ServiceBus) removes the conflict.
#   see https://learn.microsoft.com/en-us/nuget/reference/errors-and-warnings/nu1605
#   see https://learn.microsoft.com/en-us/dotnet/core/rid-catalog
#   see https://www.nuget.org/packages/SSH.NET/2016.1.0
#   see https://www.nuget.org/packages/Microsoft.Azure.Amqp/2.5.6
FROM mcr.microsoft.com/dotnet/sdk:10.0.403-noble AS build
COPY --from=node:22.23.4-bookworm-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22.23.4-bookworm-slim /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
WORKDIR /src
COPY . .
RUN --mount=type=secret,id=ca,required=false \
    if [ -f /run/secrets/ca ]; then export SSL_CERT_FILE=/run/secrets/ca NODE_EXTRA_CA_CERTS=/run/secrets/ca; fi; \
    if grep -qs '"build"' "src/ControlTower.Tower.Api/ClientApp/package.json"; then cd "src/ControlTower.Tower.Api/ClientApp" && \
      if [ -f package-lock.json ]; then npm ci; else npm install; fi && npm run build && \
      mkdir -p /opt/npm-prebuilt && printf '#!/bin/sh\necho "npm $*: skipped, the front end was built before dotnet publish" >&2\n' \
        > /opt/npm-prebuilt/npm && chmod +x /opt/npm-prebuilt/npm; fi
# optional build secret 'ca': CA bundle for TLS-inspecting corporate proxies
RUN --mount=type=cache,target=/root/.nuget/packages --mount=type=secret,id=ca,required=false \
    if [ -f /run/secrets/ca ]; then export SSL_CERT_FILE=/run/secrets/ca NODE_EXTRA_CA_CERTS=/run/secrets/ca; fi; \
    export PATH=/opt/npm-prebuilt:$PATH; \
    dotnet restore "src/ControlTower.Tower.Api/ControlTower.Tower.Api.csproj" \
 && dotnet publish "src/ControlTower.Tower.Api/ControlTower.Tower.Api.csproj" --no-restore -c Release -o /out -p:UseAppHost=false
RUN mkdir -p /writable/app/logs /writable/data/controltower/keys/tower /writable/tmp

FROM mcr.microsoft.com/dotnet/aspnet:10.0.14-noble-chiseled-extra AS final
WORKDIR /app
# application files stay owned by root: read-only for the app user
COPY --from=build /out .
COPY --from=build --chown=1654:1654 /writable/app/logs /app/logs
COPY --from=build --chown=1654:1654 /writable/data/controltower/keys/tower /data/controltower/keys/tower
COPY --from=build --chown=1654:1654 /writable/tmp /tmp
ENV ASPNETCORE_ENVIRONMENT="Production" \
    ASPNETCORE_HTTP_PORTS="8080" \
    CONTROLTOWER_LOG_DIR="/app/logs" \
    DOTNET_ENVIRONMENT="Production" \
    DOTNET_ROLL_FORWARD="Major" \
    DataProtection__KeyFolder="/data/controltower/keys/tower"
USER 1654
EXPOSE 8080
ENTRYPOINT ["dotnet", "ControlTower.Tower.Api.dll"]
