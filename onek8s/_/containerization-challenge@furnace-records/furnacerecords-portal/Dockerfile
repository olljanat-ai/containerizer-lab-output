# syntax=docker/dockerfile:1.7
# Generated by containerizer for FurnaceRecords.Portal (web, net8.0)
#
# Why this differs from a default build:
# - plan-negotiate-krb5: Windows (Negotiate/Kerberos) authentication on Linux needs the GSSAPI
#   libraries and a keytab; the image gets the packages and KRB5_KTNAME points at a keytab mounted
#   from a Secret.
#   see https://learn.microsoft.com/en-us/aspnet/core/security/authentication/windowsauth
# - plan-global-json: global.json pins an SDK version that the build image may not have; it is
#   removed in the build stage only (never in the repository) so the image's SDK builds the project.
#   see https://learn.microsoft.com/en-us/dotnet/core/tools/global-json
# - plan-dataprotection-keys: ASP.NET Core Data Protection writes its key ring under the user's home
#   folder; with a read-only root file system that folder must be writable (persist it, or share it
#   via PersistKeysTo*, when running more than one replica).
#   see https://learn.microsoft.com/en-us/aspnet/core/security/data-protection/configuration/overview
FROM mcr.microsoft.com/dotnet/sdk:10.0.403-noble AS build
WORKDIR /src
COPY . .
RUN find . -name 'global.json' -not -path '*/node_modules/*' -delete
# optional build secret 'ca': CA bundle for TLS-inspecting corporate proxies
RUN --mount=type=cache,target=/root/.nuget/packages --mount=type=secret,id=ca,required=false \
    if [ -f /run/secrets/ca ]; then export SSL_CERT_FILE=/run/secrets/ca NODE_EXTRA_CA_CERTS=/run/secrets/ca; fi; \
    dotnet restore "src/FurnaceRecords.Portal/FurnaceRecords.Portal.csproj" -p:RuntimeIdentifier=linux-x64 \
 && dotnet publish "src/FurnaceRecords.Portal/FurnaceRecords.Portal.csproj" --no-restore -c Release -o /out -p:UseAppHost=false -p:RuntimeIdentifier=linux-x64 --self-contained false
RUN mkdir -p /writable/home/app/.aspnet/DataProtection-Keys /writable/tmp

FROM mcr.microsoft.com/dotnet/aspnet:10.0.14-noble AS final
RUN apt-get update \
 && apt-get install -y --no-install-recommends gss-ntlmssp libgssapi-krb5-2 libkrb5-3 \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
# application files stay owned by root: read-only for the app user
COPY --from=build /out .
COPY --from=build --chown=1654:1654 /writable/home/app/.aspnet/DataProtection-Keys /home/app/.aspnet/DataProtection-Keys
COPY --from=build --chown=1654:1654 /writable/tmp /tmp
ENV ASPNETCORE_ENVIRONMENT="Production" \
    ASPNETCORE_HTTP_PORTS="8080" \
    DOTNET_ENVIRONMENT="Production" \
    DOTNET_ROLL_FORWARD="Major" \
    KRB5_KTNAME="/etc/krb5/keytab/service.keytab"
USER 1654
EXPOSE 8080
ENTRYPOINT ["dotnet", "FurnaceRecords.Portal.dll"]
