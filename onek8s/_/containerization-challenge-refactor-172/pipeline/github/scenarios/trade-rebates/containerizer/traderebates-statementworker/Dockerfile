# syntax=docker/dockerfile:1.7
# Generated by containerizer for TradeRebates.StatementWorker (console, net8.0)
#
# Why this differs from a default build:
# - config-windows-paths: Windows paths in configuration (drive letters, UNC shares) are overridden
#   with environment variables to folders under /data, which the manifests mount as volumes; the
#   application code is not changed.
#   see https://learn.microsoft.com/en-us/aspnet/core/fundamentals/configuration/
# - plan-global-json: global.json pins an SDK version that the build image may not have; it is
#   removed in the build stage only (never in the repository) so the image's SDK builds the project.
#   see https://learn.microsoft.com/en-us/dotnet/core/tools/global-json
FROM mcr.microsoft.com/dotnet/sdk:10.0.403-noble AS build
WORKDIR /src
COPY . .
RUN find . -name 'global.json' -not -path '*/node_modules/*' -delete
# optional build secret 'ca': CA bundle for TLS-inspecting corporate proxies
RUN --mount=type=cache,target=/root/.nuget/packages --mount=type=secret,id=ca,required=false \
    if [ -f /run/secrets/ca ]; then export SSL_CERT_FILE=/run/secrets/ca NODE_EXTRA_CA_CERTS=/run/secrets/ca; fi; \
    dotnet restore "src/TradeRebates.StatementWorker/TradeRebates.StatementWorker.csproj" -p:RuntimeIdentifier=linux-x64 \
 && dotnet publish "src/TradeRebates.StatementWorker/TradeRebates.StatementWorker.csproj" --no-restore -c Release -o /out -p:UseAppHost=false -p:RuntimeIdentifier=linux-x64 --self-contained false
RUN mkdir -p /writable/data/statements /writable/tmp

FROM mcr.microsoft.com/dotnet/runtime:10.0.14-noble-chiseled-extra AS final
WORKDIR /app
# application files stay owned by root: read-only for the app user
COPY --from=build /out .
COPY --from=build --chown=1654:1654 /writable/data/statements /data/statements
COPY --from=build --chown=1654:1654 /writable/tmp /tmp
ENV DOTNET_ENVIRONMENT="Production" \
    DOTNET_ROLL_FORWARD="Major" \
    Statements__Root="/data/statements"
USER 1654
ENTRYPOINT ["dotnet", "TradeRebates.StatementWorker.dll"]
