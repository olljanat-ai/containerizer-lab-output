# syntax=docker/dockerfile:1.7
# Generated by containerizer for FieldService.Worker (worker, net8.0)
#
# Why this differs from a default build:
# - config-windows-paths: Windows paths in configuration (drive letters, UNC shares) are overridden
#   with environment variables to folders under /data, which the manifests mount as volumes; the
#   application code is not changed.
#   see https://learn.microsoft.com/en-us/aspnet/core/fundamentals/configuration/
FROM mcr.microsoft.com/dotnet/sdk:10.0.403-noble AS build
WORKDIR /src
COPY . .
# optional build secret 'ca': CA bundle for TLS-inspecting corporate proxies
RUN --mount=type=cache,target=/root/.nuget/packages --mount=type=secret,id=ca,required=false \
    if [ -f /run/secrets/ca ]; then export SSL_CERT_FILE=/run/secrets/ca NODE_EXTRA_CA_CERTS=/run/secrets/ca; fi; \
    dotnet restore "src/FieldService.Worker/FieldService.Worker.csproj" -p:RuntimeIdentifier=linux-x64 \
 && dotnet publish "src/FieldService.Worker/FieldService.Worker.csproj" --no-restore -c Release -o /out -p:UseAppHost=false -p:RuntimeIdentifier=linux-x64 --self-contained false
RUN mkdir -p /writable/data/fieldservice/worker/state /writable/data/import/fieldservice /writable/data/inbox /writable/data/inbox/failed /writable/data/inbox/processed /writable/data/reports /writable/tmp

FROM mcr.microsoft.com/dotnet/runtime:10.0.14-noble-chiseled-extra AS final
WORKDIR /app
# application files stay owned by root: read-only for the app user
COPY --from=build /out .
COPY --from=build --chown=1654:1654 /writable/data/fieldservice/worker/state /data/fieldservice/worker/state
COPY --from=build --chown=1654:1654 /writable/data/import/fieldservice /data/import/fieldservice
COPY --from=build --chown=1654:1654 /writable/data/inbox /data/inbox
COPY --from=build --chown=1654:1654 /writable/data/inbox/failed /data/inbox/failed
COPY --from=build --chown=1654:1654 /writable/data/inbox/processed /data/inbox/processed
COPY --from=build --chown=1654:1654 /writable/data/reports /data/reports
COPY --from=build --chown=1654:1654 /writable/tmp /tmp
ENV DOTNET_ENVIRONMENT="Production" \
    DOTNET_ROLL_FORWARD="Major" \
    Worker__ArchiveFolder="/data/inbox/processed" \
    Worker__ErrorFolder="/data/inbox/failed" \
    Worker__InboxFolder="/data/inbox" \
    Worker__OutboxFolder="/data/import/fieldservice" \
    Worker__ReportFolder="/data/reports" \
    Worker__StateFolder="/data/fieldservice/worker/state"
USER 1654
ENTRYPOINT ["dotnet", "FieldService.Worker.dll"]
