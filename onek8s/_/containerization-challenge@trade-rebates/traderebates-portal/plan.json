{
  "component": "TradeRebates.Portal",
  "kind": "dotnet",
  "role": "web",
  "project": "src/TradeRebates.Portal/TradeRebates.Portal.csproj",
  "tfm": "net8.0",
  "multi_target": false,
  "strategy": "rollforward",
  "base": "full",
  "add_packages": [
    "libkrb5-3",
    "libgssapi-krb5-2",
    "gss-ntlmssp"
  ],
  "env": {
    "ASPNETCORE_HTTP_PORTS": "8080",
    "DOTNET_ENVIRONMENT": "Production",
    "ASPNETCORE_ENVIRONMENT": "Production",
    "DOTNET_ROLL_FORWARD": "Major",
    "KRB5_KTNAME": "/etc/krb5/keytab/service.keytab"
  },
  "add_writable": [
    "/tmp",
    "/home/app/.aspnet/DataProtection-Keys"
  ],
  "publish_args": [],
  "remove_files": [
    "global.json"
  ],
  "single_replica": false,
  "uid": 1654,
  "port": 8080,
  "health": null,
  "entry": "TradeRebates.Portal.dll",
  "spa_root": null,
  "args": [],
  "applied": [
    "plan-negotiate-krb5",
    "plan-global-json",
    "plan-dataprotection-keys"
  ],
  "reasons": [
    {
      "rule": "plan-negotiate-krb5",
      "why": "Windows (Negotiate/Kerberos) authentication on Linux needs the GSSAPI libraries and a keytab; the image gets the packages and KRB5_KTNAME points at a keytab mounted from a Secret.",
      "refs": [
        "https://learn.microsoft.com/en-us/aspnet/core/security/authentication/windowsauth"
      ]
    },
    {
      "rule": "plan-global-json",
      "why": "global.json pins an SDK version that the build image may not have; it is removed in the build stage only (never in the repository) so the image's SDK builds the project.",
      "refs": [
        "https://learn.microsoft.com/en-us/dotnet/core/tools/global-json"
      ]
    },
    {
      "rule": "plan-dataprotection-keys",
      "why": "ASP.NET Core Data Protection keeps its key ring under the user's home folder. The generated manifests mount one key there, read-only, from a Secret that External Secrets Operator generates once in the cluster, so every replica and restart shares it (PersistKeysTo* in code takes over when present).",
      "refs": [
        "https://learn.microsoft.com/en-us/aspnet/core/security/data-protection/configuration/overview"
      ]
    }
  ],
  "egress": [
    {
      "id": "sql-server",
      "ports": [
        {
          "port": 1433,
          "protocol": "TCP"
        }
      ]
    },
    {
      "id": "active-directory",
      "ports": [
        {
          "port": 88,
          "protocol": "TCP"
        },
        {
          "port": 88,
          "protocol": "UDP"
        },
        {
          "port": 389,
          "protocol": "TCP"
        },
        {
          "port": 636,
          "protocol": "TCP"
        },
        {
          "port": 464,
          "protocol": "TCP"
        },
        {
          "port": 3268,
          "protocol": "TCP"
        },
        {
          "port": 3269,
          "protocol": "TCP"
        }
      ]
    }
  ],
  "hardening_exceptions": [
    {
      "id": "kerberos-keytab",
      "why": "Windows authentication on Linux needs the service keytab (from a Secret, never the image) and a writable credential cache."
    },
    {
      "id": "file-uploads",
      "why": "ASP.NET Core buffers uploads larger than 64 KB to temporary files."
    }
  ]
}