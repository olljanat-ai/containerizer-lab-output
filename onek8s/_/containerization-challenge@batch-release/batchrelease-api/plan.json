{
  "component": "BatchRelease.Api",
  "kind": "dotnet",
  "role": "web",
  "project": "src/BatchRelease.Api/BatchRelease.Api.csproj",
  "tfm": "net8.0",
  "multi_target": false,
  "strategy": "rollforward",
  "base": "chiseled",
  "add_packages": [],
  "env": {
    "ASPNETCORE_HTTP_PORTS": "8080",
    "DOTNET_ENVIRONMENT": "Production",
    "ASPNETCORE_ENVIRONMENT": "Production",
    "DOTNET_ROLL_FORWARD": "Major"
  },
  "add_writable": [
    "/tmp",
    "/home/app/.aspnet/DataProtection-Keys"
  ],
  "publish_args": [],
  "remove_files": [
    "global.json"
  ],
  "single_replica": false,
  "uid": 1654,
  "port": 8080,
  "health": "/health",
  "entry": "BatchRelease.Api.dll",
  "spa_root": null,
  "args": [],
  "applied": [
    "plan-global-json",
    "plan-dataprotection-keys"
  ],
  "reasons": [
    {
      "rule": "plan-global-json",
      "why": "global.json pins an SDK version that the build image may not have; it is removed in the build stage only (never in the repository) so the image's SDK builds the project.",
      "refs": [
        "https://learn.microsoft.com/en-us/dotnet/core/tools/global-json"
      ]
    },
    {
      "rule": "plan-dataprotection-keys",
      "why": "ASP.NET Core Data Protection keeps its key ring under the user's home folder. The generated manifests mount one key there, read-only, from a Secret that External Secrets Operator generates once in the cluster, so every replica and restart shares it (PersistKeysTo* in code takes over when present).",
      "refs": [
        "https://learn.microsoft.com/en-us/aspnet/core/security/data-protection/configuration/overview"
      ]
    }
  ],
  "egress": [
    {
      "id": "sql-server",
      "ports": [
        {
          "port": 1433,
          "protocol": "TCP"
        }
      ]
    },
    {
      "id": "http-apis",
      "ports": [
        {
          "port": 443,
          "protocol": "TCP"
        },
        {
          "port": 80,
          "protocol": "TCP"
        }
      ]
    },
    {
      "id": "configured-ports",
      "ports": [
        {
          "port": 5443,
          "protocol": "TCP"
        }
      ]
    }
  ],
  "hardening_exceptions": []
}