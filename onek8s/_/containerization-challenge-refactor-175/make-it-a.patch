 3 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/scenarios/parts-catalog/src/PartsCatalog/PartsCatalog.csproj b/scenarios/parts-catalog/src/PartsCatalog/PartsCatalog.csproj
index 2d805c7..36e7015 100644
--- a/scenarios/parts-catalog/src/PartsCatalog/PartsCatalog.csproj
+++ b/scenarios/parts-catalog/src/PartsCatalog/PartsCatalog.csproj
@@ -8,7 +8,10 @@
   </PropertyGroup>
 
   <ItemGroup>
-    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
   </ItemGroup>
 
+  <ItemGroup>
+    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
+    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.0" />
+  </ItemGroup>
 </Project>
diff --git a/scenarios/parts-catalog/src/PartsCatalog/Program.cs b/scenarios/parts-catalog/src/PartsCatalog/Program.cs
index 7575612..63c702c 100644
--- a/scenarios/parts-catalog/src/PartsCatalog/Program.cs
