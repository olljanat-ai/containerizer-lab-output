@@ -1,6 +1,6 @@
 {
   "ConnectionStrings": {
-    "Catalog": "Data Source=App_Data/catalog.db"
+    "Catalog": "Server=sqlserver;Database=PartsCatalog;TrustServerCertificate=True"
   },
   "Catalog": {
     "DataFolder": "App_Data",
