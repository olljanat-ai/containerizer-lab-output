# /etc/containerizer/web.env: the web UI (docs/sign-in.md). Mode 600.
# The admin pages, the System page (upgrade, roll back) and the Firewall page appear once sign-in is set up.
# Register https://<CZ_HOSTNAME>/auth/callback as the redirect URI at your identity provider.
CONTAINERIZER_OIDC_ISSUER=https://login.microsoftonline.com/c7496d01-3dde-45a1-9cda-11cc2f3edace/v2.0
CONTAINERIZER_OIDC_CLIENT_ID=f5f2d167-26a2-4902-8132-7b795a1e010b
CONTAINERIZER_OIDC_CLIENT_SECRET=<set: not backed up>
# who may use the admin pages: user:<sub>, email:<address>, group:<id>, role:<app role> (comma separated)
CONTAINERIZER_ADMINS=group:4dad52dc-58da-46bb-8320-1dc4a1e962c1
# scoped roles (docs/sign-in.md#roles): operators run organization scans; product owners map their apps.
# Only administrators see the System (upgrade, roll back) and Firewall pages.
CONTAINERIZER_OPERATORS=
CONTAINERIZER_PRODUCT_OWNERS=
# empty: the results pages are readable without sign-in by anyone who reaches HTTPS
CONTAINERIZER_VIEWERS=
CONTAINERIZER_VIEW_AUDIT=false
CONTAINERIZER_API_AUDIENCE=
CONTAINERIZER_API_CLIENTS=
# CONTAINERIZER_PUBLIC_URL=https://containerizer.example.com   (default: https://<CZ_HOSTNAME>)
# largest dev database backup an operator can upload, in MB (Admin -> Dev databases)
# CONTAINERIZER_DEV_DB_MAX_MB=2048
