# /etc/containerizer/grafana.env: extra Grafana settings (GF_*), e.g. sign-in with your identity provider:
GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME=SSO
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=efaee2f7-abdb-4932-bfe8-2b424f7f3d8a
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=<set: not backed up>
GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://login.microsoftonline.com/c7496d01-3dde-45a1-9cda-11cc2f3edace/oauth2/v2.0/authorize
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=<set: not backed up>
# GF_AUTH_GENERIC_OAUTH_API_URL=
GF_AUTH_DISABLE_LOGIN_FORM=false
GF_AUTH_GENERIC_OAUTH_SCOPES=openid profile email
